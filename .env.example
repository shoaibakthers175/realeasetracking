# Server Configuration
PORT=5000
NODE_ENV=production

# Database (MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/analytics?retryWrites=true&w=majority

# Authentication Security
JWT_SECRET=your-secure-jwt-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# CORS Allowed Origin (Client URL)
CORS_ORIGIN=https://releasetrack-client.onrender.com,http://localhost:5173
